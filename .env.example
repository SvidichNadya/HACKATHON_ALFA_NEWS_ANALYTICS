# Copy to .env. Everything is optional: without LLM keys the service runs in deterministic mode.
RADAR_DEMO_PASSWORD=alfa-radar-demo
RADAR_SECRET_KEY=
RADAR_COOKIE_SECURE=0

# Allowed models only: Gemma 4 26B A4B | GLM-5.3-Flash | Qwen3.6 35B A3B | DeepSeek-V4.1-Flash | Qwen3-VL-30B-A3B-Instruct | Kimi-K2.6
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL_LIGHT=Gemma 4 26B A4B
LLM_MODEL_DEEP=GLM-5.3-Flash
LLM_DAILY_TOKEN_BUDGET=400000
LLM_RUN_TOKEN_BUDGET=24000

AGENT_MAX_STEPS=18
AGENT_MAX_REPLANS=2
AGENT_WALL_SECONDS=60
WEB_WORKERS=2
